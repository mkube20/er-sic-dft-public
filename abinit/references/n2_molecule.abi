# n2_molecule: isolated N2 molecule (chemical-potential reference).
# Shared settings: ../common_parameters.abi. See README.md for the full workflow.

acell   18.0  18.0  18.0   # Bohr, cubic box for the isolated molecule
angdeg  90.0  90.0  90.0

ntypat  1
znucl   7   # N
natom   2
typat   1 1
xcart
   9.0  9.0   7.96254
   9.0  9.0  10.03746

kptopt  0
nkpt    1
kpt     0.0  0.0  0.0
istwfk  1

include "../common_parameters.abi"

occopt  3
nband   10
usepawu 0
lpawu  -1
upawu   0.0
jpawu   0.0

pseudos "N.xml"

ionmov  0
