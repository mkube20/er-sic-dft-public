# h2_molecule: isolated H2 molecule (chemical-potential reference).
# Shared settings: ../common_parameters.abi. See README.md for the full workflow.

acell   18.0  18.0  18.0   # Bohr
angdeg  90.0  90.0  90.0

ntypat  1
znucl   1   # H
natom   2
typat   1 1
xcart
   9.0  9.0   8.29986
   9.0  9.0   9.70014

kptopt  0
nkpt    1
kpt     0.0  0.0  0.0
istwfk  1

include "../common_parameters.abi"

usepawu 0
lpawu  -1
upawu   0.0
jpawu   0.0

nsppol  1
occopt  1   # non-metallic occupations; the gap is enormous
nband   4

pseudos "H.xml"

pawovlp 20

ionmov  0
