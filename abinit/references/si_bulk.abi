# si_bulk: bulk Si, diamond structure (chemical-potential reference).
# Shared settings: ../common_parameters.abi. See README.md for the full workflow.

acell   3*10.2635   # Bohr
rprim   0.0  0.5  0.5
        0.5  0.0  0.5
        0.5  0.5  0.0

ntypat  1
znucl   14
natom   2
typat   1 1
xred
   0.0  0.0  0.0
   0.25 0.25 0.25

kptopt  1
ngkpt   8 8 8
nshiftk 4
shiftk  0.5 0.5 0.5
        0.5 0.0 0.0
        0.0 0.5 0.0
        0.0 0.0 0.5

include "../common_parameters.abi"
occopt  3
usepawu 0
lpawu   -1

pseudos "Si.xml"

optcell 2
ionmov  22
ntime   30
tolmxf  5.0d-5
ecutsm  0.5
dilatmx 1.05
