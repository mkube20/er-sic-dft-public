# er_ho_relax3_spin: Er_Si(h)+O_C, charge 0; relaxation.
# Shared settings: ../common_parameters.abi. See README.md for the full workflow.

ndtset  1

acell   23.3596  23.3596  19.1440   # Bohr
angdeg  90.0  90.0  120.0
rprim   1.0  0.0  0.0
        -0.5  0.8660254038  0.0
        0.0  0.0  1.0

ntypat  4
znucl   14 6 68 8   # Si, C, Er, O
natom   128
include "../production/positions_er_ho_relaxed_spin_q0.abi"   # PASS-2 relaxed coords

kptopt  1
ngkpt   2 2 2
nshiftk 1
shiftk  0.0 0.0 0.0

istwfk *1

include "../common_parameters.abi"

occopt     3
usepawu    1
lpawu      -1 -1 3 -1
upawu      0.0 0.0 0.265 0.0   # Ha (7.21 eV) — Er 4f U
jpawu      0.0 0.0 0.0 0.0
pseudos "Si.xml, C.xml, Er.xml, O.xml"

ionmov  22   # L-BFGS
ntime   40   # pass 3 starts AT pass 2's minimum; 40 is ample
tolmxf  5.0d-5   # Ha/Bohr -> ~2.5 meV/Ang
ecutsm  0.5
optcell 0

prtvol  1

nband   336

prtwf   0

nstep1   200
diemix1  0.2   # reduced mixing for the hybrid SCF

nsppol  2
nspden  2

usedmatpu 60
dmatpawu
    1.00026  0.00074 -0.00008 -0.00141 -0.00014  0.00043  0.00000
    0.00074  0.99924 -0.00001 -0.00051  0.00038 -0.00001  0.00011
