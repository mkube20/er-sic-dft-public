# pristine_supercell_prtpot: pristine 128-atom supercell: electrostatic potential.
# Shared settings: ../common_parameters.abi. See README.md for the full workflow.

acell   23.3596  23.3596  19.1440   # Bohr
angdeg  90.0  90.0  120.0
rprim   1.0  0.0  0.0
        -0.5  0.8660254038  0.0
        0.0  0.0  1.0

ntypat  2
znucl   14 6
natom   128
include "../production/positions_pristine.abi"

chkprim 0

kptopt  1
ngkpt   2 2 2
nshiftk 1
shiftk  0.0 0.0 0.5

include "../common_parameters.abi"

occopt  3
usepawu 0
lpawu   -1 -1
upawu   0.0 0.0
jpawu   0.0 0.0

prtpot  1
prtvxc  1
iomode  3
prtwf   0

prtvol  1
prtdos  3

pseudos "Si.xml, C.xml"

ionmov  0
ecutsm  0.5
