# er_ho_occprobe_spin: Er_Si(h)+O_C, charge 0; single point; projected DOS; 4f occupation seeded from the relaxation; geometry positions_er_ho_relaxed_spin_q0.
# Shared settings: ../common_parameters.abi. See README.md for the full workflow.

ndtset  1

acell   23.3596  23.3596  19.1440   # Bohr
angdeg  90.0  90.0  120.0
rprim   1.0  0.0  0.0
        -0.5  0.8660254038  0.0
        0.0  0.0  1.0

ntypat  4
znucl   14 6 68 8   # Si, C, Er, O
natom   128
include "../production/positions_er_ho_relaxed_spin_q0.abi"

kptopt  1
ngkpt   2 2 2
nshiftk 1
shiftk  0.0 0.0 0.0

istwfk *1

include "../common_parameters.abi"

occopt     3
usepawu    1
lpawu      -1 -1 3 -1
upawu      0.0 0.0 0.265 0.0   # Ha (7.21 eV) — Er 4f U
jpawu      0.0 0.0 0.0 0.0
pseudos "Si.xml, C.xml, Er.xml, O.xml"

ionmov  0
ntime   80   # max ionic steps
tolmxf  5.0d-5   # Ha/Bohr -> ~2.5 meV/Ang
ecutsm  0.5
optcell 0

prtvol  1

nband   336

prtwf   0

nstep1   200
diemix1  0.2   # reduced mixing for the hybrid SCF

nsppol  2
nspden  2

usedmatpu 60
dmatpawu
